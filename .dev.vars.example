# Local Cloudflare Worker development.
ALLOWED_ORIGIN=http://localhost:5173

# OpenRouter server-side configuration for TypeSafe Jev.
# Put the real key in .dev.vars (never in VITE_* or the browser bundle).
OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Robot Foundry

# Fight fallback and Sandbox commands both use OPENROUTER_JEV_MODEL.
# No Cloudflare Workers AI binding.
